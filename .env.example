# FastAPI: se enlaza solamente a localhost.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
DATABASE_URL=sqlite:///./data/tarotbot.db
LOG_LEVEL=INFO

# IA de laboratorio. Las claves reales viven solo en .env local.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_CHAT_MODEL=gemini-2.5-flash
AI_CONVERSATION_PROMPT_VERSION=tarotista_v4
AI_MEMORY_MODEL=gemini-2.5-flash
AI_TAROT_INTERPRETATION_PROMPT_VERSION=tarot_interpretation_v2
AI_TIMEOUT_SECONDS=30
# false conecta directamente y no hereda proxies del entorno; true los respeta.
AI_TRUST_ENV_PROXY=false
AI_MAX_OUTPUT_TOKENS=800
# Minutos en que una lectura reciente tiene prioridad para follow-ups; las anteriores se recuperan si se mencionan.
READING_ACTIVE_CONTEXT_MINUTES=240
GEMINI_API_KEY=
# Groq usa el SDK oficial y JSON Schema Mode; no se realizan reintentos automáticos.
GROQ_API_KEY=

# Audio entrante: Groq Whisper acepta OGG/Opus directamente; no requiere ffmpeg.
AUDIO_TRANSCRIPTION_ENABLED=true
AUDIO_TRANSCRIPTION_PROVIDER=groq
AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AUDIO_MAX_SECONDS=300
AUDIO_MAX_BYTES=12000000

# Dashboard local: se abre directamente desde localhost.
ADMIN_ENABLED=true

# Entrega humana de WhatsApp. typing_ms se calcula por fragmento y tiene techo.
WHATSAPP_TYPING_CHARS_PER_SECOND=20
WHATSAPP_MIN_TYPING_MS=1800
WHATSAPP_MAX_TYPING_MS=22000
WHATSAPP_INTER_MESSAGE_DELAY_MS_MIN=600
WHATSAPP_INTER_MESSAGE_DELAY_MS_MAX=1800

# Gateway Node -> FastAPI.
WHATSAPP_BACKEND_URL=http://127.0.0.1:5001
WHATSAPP_AUTH_FOLDER=./whatsapp-sessions
# Máximo de espera Node -> FastAPI; cubre una respuesta IA síncrona lenta.
BACKEND_REQUEST_TIMEOUT_MS=60000
# Ventana humana de recolección de mensajes físicos antes de llamar al backend.
WHATSAPP_MESSAGE_IDLE_MS=12000
WHATSAPP_TYPING_GRACE_MS=15000
WHATSAPP_MAX_COLLECTION_MS=60000
