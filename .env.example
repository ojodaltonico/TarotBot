# FastAPI: se enlaza solamente a localhost.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
DATABASE_URL=sqlite:///./data/tarotbot.db
LOG_LEVEL=INFO

# IA de laboratorio (Gemini). La clave real vive solo en .env local.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_CHAT_MODEL=gemini-2.5-flash
AI_MEMORY_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
GEMINI_API_KEY=

# Gateway Node -> FastAPI.
WHATSAPP_BACKEND_URL=http://127.0.0.1:5001
WHATSAPP_AUTH_FOLDER=./whatsapp-sessions
